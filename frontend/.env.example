# ==============================================================================
# Next.js 15 App Router, Prisma & Auth.js v5 Template (`frontend/.env.example`)
# Copy to `frontend/.env` (`cp frontend/.env.example frontend/.env`)
# ==============================================================================

# --- PostgreSQL Connection for Prisma ORM ---
DATABASE_URL="postgresql://qa_admin:qa_secret_password@localhost:5432/qa_platform_db?schema=public"

# --- Shared Cross-Service HS256 JWT Secret (MUST match `backend/.env` AUTH_SECRET) ---
AUTH_SECRET="super-secret-shared-hs256-signing-key-minimum-32-bytes-long-2026"
NEXTAUTH_SECRET="super-secret-shared-hs256-signing-key-minimum-32-bytes-long-2026"
JWT_ALGORITHM="HS256"

# --- Application & Backend API URLs ---
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
FASTAPI_INTERNAL_URL="http://localhost:8000"

