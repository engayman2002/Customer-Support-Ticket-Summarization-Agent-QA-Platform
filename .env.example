# ==============================================================================
# Customer Support Ticket Summarization & Agent QA Platform - Environment Config
# ==============================================================================
# IMPORTANT CROSS-SERVICE CONTRACT:
# Both Next.js (`frontend/`) and FastAPI (`backend/`) MUST load the exact same
# `AUTH_SECRET` and `JWT_ALGORITHM=HS256`.
# Next.js (Auth.js v5) mints an HS256-signed JWS `accessToken` using `AUTH_SECRET`,
# and FastAPI verifies `Authorization: Bearer <accessToken>` directly using
# the same `AUTH_SECRET` and `JWT_ALGORITHM=HS256`.
# ==============================================================================

# --- PostgreSQL Container Credentials ---
POSTGRES_USER=qa_admin
POSTGRES_PASSWORD=qa_secret_password
POSTGRES_DB=qa_platform_db
POSTGRES_PORT=5432

# --- Database Connection Strings ---
# Used by Prisma (Next.js frontend & migrations)
DATABASE_URL="postgresql://qa_admin:qa_secret_password@localhost:5432/qa_platform_db?schema=public"

# Used by SQLAlchemy 2.0 AsyncEngine (FastAPI backend)
ASYNC_DATABASE_URL="postgresql+asyncpg://qa_admin:qa_secret_password@localhost:5432/qa_platform_db"

# --- Redis Broker & Rate-Limiter Store ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# --- Unified Cross-Service JWT & Auth.js Contract (MUST MATCH IN BOTH SERVICES) ---
AUTH_SECRET="super-secret-shared-hs256-signing-key-minimum-32-bytes-long-2026"
NEXTAUTH_SECRET="super-secret-shared-hs256-signing-key-minimum-32-bytes-long-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Service URLs ---
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
FASTAPI_INTERNAL_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000"

