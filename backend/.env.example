# ==============================================================================
# FastAPI Backend & Pluggable Multi-LLM Provider Template (`backend/.env.example`)
# Copy to `backend/.env` (`cp backend/.env.example backend/.env`)
# ==============================================================================

PROJECT_NAME="Customer Support Ticket Summarization & Agent QA Platform"
API_V1_STR="/api/v1"

# --- Database & Redis Connections ---
DATABASE_URL="postgresql://qa_admin:qa_secret_password@localhost:5432/qa_platform_db?schema=public"
ASYNC_DATABASE_URL="postgresql+asyncpg://qa_admin:qa_secret_password@localhost:5432/qa_platform_db"
REDIS_URL="redis://localhost:6379/0"

# --- Security, JWT & AES-256-GCM Credential Encryption ---
AUTH_SECRET="super-secret-shared-hs256-signing-key-minimum-32-bytes-long-2026"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS="http://localhost:3000"

# ==============================================================================
# Pluggable Multi-LLM Provider Selection (`backend/app/LLM_Providers/`)
# Supported values: "groq" | "openai" | "gemini" | "anthropic" | "ollama"
# ==============================================================================
LLM_PROVIDER="groq"

# --- 1. Groq LPU Provider Settings ---
GROQ_API_KEY=""
GROQ_PRIMARY_MODEL="llama-3.3-70b-versatile"
GROQ_FALLBACK_MODEL="llama-3.1-8b-instant"
GROQ_COMPRESSION_MODEL="llama-3.1-8b-instant"

# --- 2. OpenAI / OpenAI-Compatible Provider Settings ---
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_PRIMARY_MODEL="gpt-4o"
OPENAI_FALLBACK_MODEL="gpt-4o-mini"
OPENAI_COMPRESSION_MODEL="gpt-4o-mini"

# --- 3. Google Gemini Provider Settings ---
GEMINI_API_KEY=""
GEMINI_PRIMARY_MODEL="gemini-2.5-pro"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"
GEMINI_COMPRESSION_MODEL="gemini-2.5-flash"

# --- 4. Anthropic Claude Provider Settings ---
ANTHROPIC_API_KEY=""
ANTHROPIC_PRIMARY_MODEL="claude-3-5-sonnet-latest"
ANTHROPIC_FALLBACK_MODEL="claude-3-5-haiku-latest"
ANTHROPIC_COMPRESSION_MODEL="claude-3-5-haiku-latest"

# --- 5. Local Ollama Provider Settings ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_PRIMARY_MODEL="llama3.2"
OLLAMA_FALLBACK_MODEL="llama3.2"
OLLAMA_COMPRESSION_MODEL="llama3.2"

# --- Distributed Rate Limiter & Context Window Budgets ---
LLM_RPM_LIMIT=30
LLM_TPM_LIMIT=15000
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=15000
TRANSCRIPT_MAX_VERBATIM_TOKENS=10000

